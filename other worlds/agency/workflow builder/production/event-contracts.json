{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Sales Agent & CRM — Event Contracts",
  "description": "JSON event schemas for WhatsApp-centred AI sales agent + CRM. Tenant-isolated. All monetary values in minor currency units where applicable (KES).",
  "version": "1.0.0",

  "common": {
    "description": "Fields present on every event.",
    "schemaVersion": { "type": "string", "example": "1.0.0" },
    "eventId": { "type": "string", "description": "Unique id per event (UUID). Used for idempotency." },
    "idempotencyKey": { "type": "string", "description": "Client-generated key to deduplicate retries." },
    "eventType": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string" },
    "sourceChannel": { "type": "string", "enum": ["whatsapp", "web_demo", "api"] },
    "externalMessageId": { "type": "string", "description": "WhatsApp message id or channel message id" },
    "customer": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "phone"]
    },
    "conversationId": { "type": "string" }
  },

  "orderItem": {
    "type": "object",
    "required": ["productId", "quantity", "unitPrice", "lineTotal"],
    "properties": {
      "productId": { "type": "string" },
      "variantId": { "type": "string" },
      "variantName": { "type": "string" },
      "quantity": { "type": "integer", "minimum": 1 },
      "unitPrice": { "type": "number", "minimum": 0 },
      "lineTotal": { "type": "number", "minimum": 0 }
    }
  },

  "events": {
    "order.created": {
      "description": "Emitted when a customer explicitly confirms and an order is created once (idempotent).",
      "required": ["order", "conversationId"],
      "properties": {
        "order": {
          "type": "object",
          "required": ["id", "customer", "items", "grandTotal", "status", "demoOrder"],
          "properties": {
            "id": { "type": "string" },
            "customer": { "$ref": "#/common/customer" },
            "items": { "type": "array", "items": { "$ref": "#/orderItem" } },
            "subtotal": { "type": "number" },
            "discount": { "type": "number" },
            "deliveryFee": { "type": "number" },
            "grandTotal": { "type": "number" },
            "amountPaid": { "type": "number" },
            "outstandingBalance": { "type": "number" },
            "deliveryZone": { "type": "string" },
            "customerName": { "type": "string" },
            "customerPhone": { "type": "string" },
            "status": { "type": "string", "enum": ["created", "awaiting_payment", "paid", "fulfilled", "completed", "cancelled", "refunded"] },
            "paymentStatus": { "type": "string", "enum": ["unpaid", "pending", "verified", "failed", "refunded"] },
            "demoOrder": { "type": "boolean" },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "conversationId": { "type": "string" },
        "integrationResult": { "type": "string", "enum": ["success", "failure", "retrying"] },
        "errorDetails": { "type": "string" }
      }
    },

    "payment.verified": {
      "description": "Trusted payment callback (M-Pesa Daraja). Verifies order, merchant, amount, transaction reference. Idempotent on repeated callbacks.",
      "required": ["orderId", "payment", "conversationId"],
      "properties": {
        "orderId": { "type": "string" },
        "payment": {
          "type": "object",
          "required": ["method", "amount", "transactionReference", "status"],
          "properties": {
            "method": { "type": "string", "enum": ["mpesa", "cash_on_delivery", "other"] },
            "amount": { "type": "number", "minimum": 0 },
            "transactionReference": { "type": "string" },
            "phoneNumber": { "type": "string" },
            "status": { "type": "string", "enum": ["pending", "verified", "failed", "refunded"] },
            "verifiedAt": { "type": "string", "format": "date-time" },
            "rawCallback": { "type": "object" }
          }
        },
        "conversationId": { "type": "string" },
        "integrationResult": { "type": "string", "enum": ["success", "failure", "retrying"] },
        "errorDetails": { "type": "string" }
      }
    },

    "fulfilment.updated": {
      "description": "Order fulfilment status change (preparing / dispatched / delivered / failed).",
      "required": ["orderId", "fulfilment"],
      "properties": {
        "orderId": { "type": "string" },
        "fulfilment": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["pending", "preparing", "dispatched", "delivered", "failed"] },
            "zone": { "type": "string" },
            "fee": { "type": "number" },
            "trackingNumber": { "type": "string" },
            "estimatedDelivery": { "type": "string", "format": "date-time" },
            "deliveredAt": { "type": "string", "format": "date-time" },
            "notes": { "type": "string" }
          }
        },
        "integrationResult": { "type": "string", "enum": ["success", "failure", "retrying"] },
        "errorDetails": { "type": "string" }
      }
    },

    "human.handoff": {
      "description": "Conversation escalated to a human agent. Unsupported or uncertain situations.",
      "required": ["conversationId", "customer", "reason"],
      "properties": {
        "conversationId": { "type": "string" },
        "customer": { "$ref": "#/common/customer" },
        "reason": { "type": "string" },
        "assignedTo": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved", "closed"] },
        "integrationResult": { "type": "string", "enum": ["success", "failure", "retrying"] },
        "errorDetails": { "type": "string" }
      }
    },

    "sync.sheets.failed": {
      "description": "Google Sheets write failed. Order preserved; error recorded for recovery/retry.",
      "required": ["orderId", "errorDetails"],
      "properties": {
        "orderId": { "type": "string" },
        "spreadsheetId": { "type": "string" },
        "tab": { "type": "string" },
        "errorDetails": { "type": "string" },
        "retryCount": { "type": "integer", "minimum": 0 },
        "integrationResult": { "type": "string", "const": "failure" }
      }
    }
  },

  "samples": {
    "order.created": {
      "schemaVersion": "1.0.0",
      "eventId": "evt_01HXYZ999",
      "idempotencyKey": "idem_order_ORD_0001_20261027",
      "eventType": "order.created",
