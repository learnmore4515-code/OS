      },
      "integrationResult": "success",
      "errorDetails": null
    },

    "payment.verified": {
      "schemaVersion": "1.0.0",
      "eventId": "evt_01HXYZ998",
      "idempotencyKey": "idem_payment_ORD_0001_TXN123",
      "eventType": "payment.verified",
      "timestamp": "2026-10-27T10:45:00Z",
      "tenantId": "tn_nairobi_trendz",
      "sourceChannel": "whatsapp",
      "externalMessageId": null,
      "customer": { "id": "c_254712345678", "phone": "+254712345678", "name": "Jane Wanjiku" },
      "conversationId": "conv_001",
      "orderId": "ORD-0001",
      "payment": {
        "method": "mpesa",
        "amount": 6300,
        "transactionReference": "TXN123456789",
        "phoneNumber": "+254712345678",
        "status": "verified",
        "verifiedAt": "2026-10-27T10:45:00Z",
