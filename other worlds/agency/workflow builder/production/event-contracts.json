    "fulfilment.updated": {
      "schemaVersion": "1.0.0",
      "eventId": "evt_01HXYZ997",
      "idempotencyKey": "idem_fulfil_ORD_0001_dispatched",
      "eventType": "fulfilment.updated",
      "timestamp": "2026-10-28T09:00:00Z",
      "tenantId": "tn_nairobi_trendz",
      "sourceChannel": "api",
      "externalMessageId": null,
      "customer": { "id": "c_254712345678", "phone": "+254712345678", "name": "Jane Wanjiku" },
      "conversationId": "conv_001",
      "orderId": "ORD-0001",
      "fulfilment": {
        "status": "dispatched",
        "zone": "Nairobi Suburbs",
