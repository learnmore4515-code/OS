{
  "name": "WhatsApp AI Sales Agent - Inbound (Zara)",
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "binaryMode": "separate",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "parameters": {
        "multipleMethods": true,
        "path": "whatsapp-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "WhatsApp Inbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [ 208, 192 ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "method", "name": "method", "value": "{{ $json.method }}", "type": "string" },
            { "id": "hubMode", "name": "hubMode", "value": "{{ $json.query?.['hub.mode'] }}", "type": "string" },
            { "id": "hubChallenge", "name": "hubChallenge", "value": "{{ $json.query?.['hub.challenge'] }}", "type": "string" },
            { "id": "hubVerifyToken", "name": "hubVerifyToken", "value": "{{ $json.query?.['hub.verify_token'] }}", "type": "string" },
            { "id": "tokenMatches", "name": "tokenMatches", "value": "{{ $json.hubVerifyToken === 'wa_verify_token_20261027' }}", "type": "boolean" },
            { "id": "body", "name": "body", "value": "{{ $json.body }}", "type": "json" }
          ],
          "includeOtherFields": true,
          "options": {}
        }
      },
      "name": "Set - Extract Request Info",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [ 432, 192 ]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [ { "leftValue": "{{ $json.hubMode }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "subscribe" } ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IF - Is Verification Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [ 656, 192 ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "{{ $json.hubChallenge }}",
        "options": { "responseCode": 200 }
      },
      "name": "Respond - Verification Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [ 880, 96 ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "from", "name": "from", "value": "{{ $json.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.from ?? $json.from ?? '' }}", "type": "string" },
            { "id": "messageText", "name": "messageText", "value": "{{ $json.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.text?.body ?? $json.text ?? '' }}", "type": "string" },
            { "id": "messageId", "name": "messageId", "value": "{{ $json.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.id ?? $json.id ?? '' }}", "type": "string" },
            { "id": "timestamp", "name": "timestamp", "value": "{{ $json.body?.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.timestamp ?? $now.toISO() }}", "type": "string" }
          ],
          "includeOtherFields": true,
          "options": {}
        }
      },
      "name": "Set - Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [ 880, 288 ]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
          "conditions": [
            { "leftValue": "{{ $json.from }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" },
            { "leftValue": "{{ $json.messageText }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IF - Validate Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [ 1104, 288 ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": { "status": "error", "message": "Missing phone number or message text" },
        "options": { "responseCode": 400 }
      },
      "name": "Respond - Invalid Input",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [ 1328, 384 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://integrate.api.nvidia.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nvidiaApi",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" }, { "name": "Accept", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "nvidia/nemotron-3-ultra-550b-a55b",
          "messages": [
            { "role": "system", "content": "=You are Zara, an AI sales agent. Help the customer discover products, build a cart, and place an order. Use the retailer catalogue and policies only. Never invent prices or stock. The customer message is: \"{{ $json.messageText }}\". Ask clarifying questions when needed. Get explicit confirmation before creating an order. Keep order state separate from payment state." },
            { "role": "user", "content": "={{ $json.messageText }}" }
          ],
          "max_tokens": 100,
          "stream": false
        },
        "options": { "response": {} }
      },
      "name": "HTTP Request - NVIDIA Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [ 1552, 192 ],
      "credentials": { "nvidiaApi": { "id": "Dd8QmjCXyPnLLfV1", "name": "NVIDIA Nemotron account" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "output", "name": "output", "value": "{{ $json.choices?.[0]?.message?.content ?? 'Sorry, I could not generate a response right now. Please try again.' }}", "type": "string" }
          ],
          "includeOtherFields": true,
          "options": {}
        }
      },
      "name": "Set - Extract NVIDIA Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [ 1776, 192 ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "to", "name": "to", "value": "{{ $('Set - Normalize Input').item.json.from }}", "type": "string" },
            { "id": "textBody", "name": "textBody", "value": "{{ $json.output }}", "type": "string" }
          ],
          "includeOtherFields": true,
          "options": {}
        }
      },
      "name": "Set - Format WhatsApp Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [ 2000, 192 ]
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "1505327545987989",
        "recipientPhoneNumber": "{{ $json.to }}",
        "textBody": "{{ $json.textBody }}",
        "additionalFields": {}
      },
      "name": "WhatsApp - Send Reply",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [ 2224, 192 ],
      "credentials": { "whatsAppApi": { "id": "q6ANEGb3Ji69RVOG", "name": "WhatsApp account 2" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": { "status": "received" },
        "options": { "responseCode": 200 }
      },
      "name": "Respond - OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [ 2448, 192 ]
    }
  ],
  "connections": {
    "WhatsApp Inbound Webhook": { "main": [ [ { "node": "Set - Extract Request Info", "type": "main", "index": 0 } ] ] },
    "Set - Extract Request Info": { "main": [ [ { "node": "IF - Is Verification Request?", "type": "main", "index": 0 } ] ] },
    "IF - Is Verification Request?": { "main": [ [ { "node": "Respond - Verification Challenge", "type": "main", "index": 0 } ], [ { "node": "Set - Normalize Input", "type": "main", "index": 0 } ] ] },
    "Set - Normalize Input": { "main": [ [ { "node": "IF - Validate Input", "type": "main", "index": 0 } ] ] },
    "IF - Validate Input": { "main": [ [ { "node": "HTTP Request - NVIDIA Chat", "type": "main", "index": 0 } ], [ { "node": "Respond - Invalid Input", "type": "main", "index": 0 } ] ] },
    "HTTP Request - NVIDIA Chat": { "main": [ [ { "node": "Set - Extract NVIDIA Response", "type": "main", "index": 0 } ] ] },
    "Set - Extract NVIDIA Response": { "main": [ [ { "node": "Set - Format WhatsApp Response", "type": "main", "index": 0 } ] ] },
    "Set - Format WhatsApp Response": { "main": [ [ { "node": "WhatsApp - Send Reply", "type": "main", "index": 0 } ] ] },
    "WhatsApp - Send Reply": { "main": [ [ { "node": "Respond - OK", "type": "main", "index": 0 } ] ] }
  }
}
