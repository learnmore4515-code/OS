# ============================================================================
# AI Sales Agent & CRM — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.
# ============================================================================

# ----------------------------------------------------------------------------
# Tenant / retailer settings (edit per retailer)
# ----------------------------------------------------------------------------
TENANT_ID=tn_nairobi_trendz
BRAND_NAME=Nairobi Trendz
THEME_COLOR=#25D366
DEMO_MODE=true
CURRENCY=KES
LANGUAGE=en

# WhatsApp demo till number (demo only — not a live integration)
MPESA_TILL=554433

# Delivery zones (KES) — edit per retailer
DELIVERY_ZONES='{"CBD":150,"Nairobi Suburbs":300,"Upcountry":450}'

DISCOUNT_ALLOWED=false
FOLLOW_UPS_ALLOWED=true
OPT_OUT_REQUIRED=true
HUMAN_HANDOFF_ENABLED=true

# ----------------------------------------------------------------------------
# WhatsApp Business Platform (production integration — credential checklist)
# Obtain from: https://developers.facebook.com (WhatsApp Business API)
# A SIM card alone does NOT activate this API — a verified Business + phone
# number ID + access token are required.
# ----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_business_account_id
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_secret_value
WHATSAPP_APP_SECRET=replace_with_meta_app_secret

# ----------------------------------------------------------------------------
# M-Pesa Daraja (production payment verification — credential checklist)
# Obtain from: https://developer.safaricom.co.ke (Daraja API)
# Requires Safaricom merchant registration (Till or Paybill).
# ----------------------------------------------------------------------------
MPESA_CONSUMER_KEY=     # Daraja consumer key
MPESA_CONSUMER_SECRET=  # Daraja consumer secret
MPESA_SHORTCODE=        # Till or Paybill number
MPESA_PASSKEY=          # Daraja passkey (from developer portal)
MPESA_ENVIRONMENT=sandbox  # sandbox | production

# ----------------------------------------------------------------------------
# AI model (n8n gateway credits or direct API key)
# OpenAI via n8n gateway credits is pre-configured in the connected instance.
# If using a direct key:
# ----------------------------------------------------------------------------
OPENAI_API_KEY=           # optional if using n8n gateway credits

# ----------------------------------------------------------------------------
# Google Sheets synchronisation (credential checklist)
# Obtain: Google Cloud service account or OAuth2 + a spreadsheet shared with it
# ----------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=  # e.g. 1BxiMVs0XRA5...
GOOGLE_SHEETS_TAB=Orders

# ----------------------------------------------------------------------------
# Slack staff notification (human handoff — credential checklist)
# Obtain: Slack app (chat:write) + channel ID
# ----------------------------------------------------------------------------
SLACK_CHANNEL_ID=   # e.g. C01ABCDEF2G

# ----------------------------------------------------------------------------
# n8n instance (connected instance URL)
# ----------------------------------------------------------------------------
N8N_BASE_URL=https://simongreenmmm.app.n8n.cloud

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
WEBHOOK_VERIFY_TOKEN=   # for validating inbound WhatsApp webhooks (signature)
ENCRYPTION_KEY=         # for encrypting stored credentials/tokens (32 chars)
